{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@noxh/ui#build": {
      "outputs": []
    },
    "@noxh/api#test": {
      "dependsOn": ["build"],
      "outputs": []
    }
  },
  "globalDependencies": ["Cargo.toml", "Cargo.lock", "crates/**", "tests/fixtures/**"]
}
