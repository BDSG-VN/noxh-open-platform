# Official upstream source, pinned; registry-distributed MinIO binaries are unavailable.
FROM golang:1.25.1-bookworm AS source
ARG UPSTREAM_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
WORKDIR /src
RUN git init && git remote add origin https://github.com/minio/minio.git && git fetch --depth 1 origin ${UPSTREAM_COMMIT} && git checkout --detach FETCH_HEAD
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /out/minio .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* && mkdir -p /data /tmp/minio && chown 65532:65532 /data /tmp/minio
ENV HOME=/tmp/minio
COPY --from=source /out/minio /usr/local/bin/minio
COPY --from=source /src/LICENSE /usr/share/doc/minio/LICENSE
LABEL org.opencontainers.image.source="https://github.com/minio/minio" org.opencontainers.image.revision="9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a" org.opencontainers.image.licenses="AGPL-3.0-only"
USER 65532:65532
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
