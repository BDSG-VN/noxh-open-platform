# DEVELOPMENT ONLY. Generate fresh ignored .env with: node scripts/init-dev-env.mjs
NODE_ENV=development
POSTGRES_USER=noxh_owner
POSTGRES_PASSWORD=
POSTGRES_DB=noxh
# Migration owner: migrate, seed and scripts/runtime-role.mjs provision only.
DATABASE_URL=
# Least-privilege login for API/worker (member of noxh_app, no DDL/BYPASSRLS/superuser).
RUNTIME_DB_USER=noxh_api
RUNTIME_DB_PASSWORD=
RUNTIME_DATABASE_URL=
# When true, /health/ready fails unless the API connects as that least-privilege login.
DATABASE_REQUIRE_LEAST_PRIVILEGE=false
REDIS_URL=redis://localhost:6379
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=
MINIO_ROOT_USER=noxh-local
MINIO_ROOT_PASSWORD=
INTERNAL_API_URL=http://localhost:4000
ALLOW_SYNTHETIC_FIXTURES=true
EXTERNAL_AI_ENABLED=false
# Open demo: synthetic numbers 0900000xxx log in with the fixed code shown on the login page,
# seed adds the fictional project "Mây Trắng", and KEYCLOAK_REALM_FILE=noxh-realm.open-demo.json
# imports demo.admin with public credentials. Never for real data or production.
DEMO_OPEN_ACCESS=false
DEMO_OPEN_OTP=123456
KEYCLOAK_REALM_FILE=noxh-realm.json
ZALO_MINIAPP_ENABLED=false
# Exact origins only, no wildcard or credentials. Empty disables cross-origin Mini App calls.
ZALO_MINIAPP_ALLOWED_ORIGINS=
# Explicit trusted ingress IP/CIDRs only. Empty ignores all forwarded peer headers.
TRUSTED_PROXY_CIDRS=
NOTIFICATIONS_EXTERNAL_ENABLED=false
# Synthetic in-app application notices only; explicit AUTH_ORGANIZATION_ID is required when enabled.
NOTIFICATIONS_AUTOMATION_ENABLED=false
# JSON public-key pins only; API must never receive the signing private key.
AUDIT_CHECKPOINT_TRUSTED_KEYS=[]
LOTTERY_PRODUCTION_ENABLED=false
AUTH_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001
AUTH_ENCRYPTION_KEY=
AUTH_HASH_KEY=
WORKFORCE_ISSUER=http://localhost:8080/realms/noxh
WORKFORCE_PUBLIC_ISSUER=http://localhost:8080/realms/noxh
WORKFORCE_CLIENT_ID=noxh-investor
INVESTOR_PUBLIC_ORIGIN=http://localhost:3001
CITIZEN_PUBLIC_ORIGIN=http://localhost:3000

PARTNER_PUBLIC_ORIGIN=http://localhost:3004

# Private document storage (native deployments); Compose uses its MinIO service.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=noxh-private
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Set CLAMD_HOST=clamav with docker compose --profile documents up.
# Blank or unavailable scanning keeps uploaded objects quarantined.
CLAMD_HOST=
CLAMD_PORT=3310

# Fixed-purpose Rust executables. Compose includes these binaries in the API image.
# Native development: pnpm native:build, then point to absolute target/release paths.
LOTTERY_ENGINE_BIN=/opt/noxh/bin/lottery-runner
PRICING_ENGINE_BIN=/opt/noxh/bin/pricing-engine
AUDIT_VERIFIER_BIN=/opt/noxh/bin/audit-verifier
RUST_KERNEL_TIMEOUT_MS=5000
